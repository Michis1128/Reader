    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ui_content_spacing_small">

    <CheckBox
        android:id="@+id/selectionCheckbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
