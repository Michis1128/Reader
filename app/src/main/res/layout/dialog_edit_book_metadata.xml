<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/ui_card_padding_horizontal"
    android:paddingTop="@dimen/ui_content_spacing"
    android:paddingEnd="@dimen/ui_card_padding_horizontal"
    android:paddingBottom="@dimen/ui_content_spacing_small">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:labelFor="@id/titleInput"
        android:text="Título"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/titleInput"
        style="@style/Widget.MichisReader.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_content_spacing_small"
        android:hint="Título"
        android:inputType="textCapSentences"
        android:maxLines="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_content_spacing_large"
        android:labelFor="@id/authorInput"
        android:text="Autor"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/authorInput"
        style="@style/Widget.MichisReader.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_content_spacing_small"
        android:hint="Autor"
        android:inputType="textCapWords"
        android:maxLines="1" />

    <TextView
        android:id="@+id/originalFileText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_content_spacing_large"
        android:textSize="12sp" />

</LinearLayout>
