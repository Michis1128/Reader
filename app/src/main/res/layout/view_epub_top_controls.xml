<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/topControls"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="5dp"
    android:paddingEnd="6dp"
    android:paddingBottom="5dp">

    <Button
        android:id="@+id/backButton"
        style="@style/Widget.MichisReader.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="&#x2039;"
        android:textAllCaps="false" />

    <TextView
        android:id="@+id/documentTitle"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textSize="17sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/toolsButton"
        style="@style/Widget.MichisReader.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Herramientas"
        android:minWidth="0dp"
        android:text="🔧"
        android:textAllCaps="false" />

    <LinearLayout
        android:id="@+id/landscapeToolsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_content_spacing_small"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/contentsButton"
            style="@style/Widget.MichisReader.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Índice"
            android:textAllCaps="false"
            android:textSize="12sp" />

        <Button
            android:id="@+id/searchButton"
            style="@style/Widget.MichisReader.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ui_content_spacing_small"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Buscar"
            android:textAllCaps="false"
            android:textSize="12sp" />

        <Button
            android:id="@+id/quotesButton"
            style="@style/Widget.MichisReader.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ui_content_spacing_small"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Citas"
            android:textAllCaps="false"
            android:textSize="12sp" />

        <Button
            android:id="@+id/dictionaryButton"
            style="@style/Widget.MichisReader.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ui_content_spacing_small"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Diccionario"
            android:textAllCaps="false"
            android:textSize="12sp" />

        <Button
            android:id="@+id/bookmarkButton"
            style="@style/Widget.MichisReader.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ui_content_spacing_small"
            android:contentDescription="Agregar o quitar marcador"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Marcador"
            android:textAllCaps="false"
            android:textSize="12sp" />

    </LinearLayout>

    <Button
        android:id="@+id/readingSettingsButton"
        style="@style/Widget.MichisReader.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_content_spacing_small"
        android:contentDescription="Ajustes de lectura"
        android:minWidth="0dp"
        android:text="Aa"
        android:textAllCaps="false" />
</LinearLayout>
