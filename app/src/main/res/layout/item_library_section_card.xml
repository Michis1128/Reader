<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ui_content_spacing"
    android:background="@drawable/background_card"
    android:orientation="vertical"
    android:paddingStart="@dimen/ui_card_padding_horizontal"
    android:paddingTop="@dimen/ui_card_padding_vertical"
    android:paddingEnd="@dimen/ui_card_padding_horizontal"
    android:paddingBottom="@dimen/ui_card_padding_vertical">

    <TextView
        android:id="@+id/eyebrowText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/ui_content_spacing_small"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/noteText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/ui_content_spacing_small"
        android:visibility="gone" />

    <TextView
        android:id="@+id/pageText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/ui_content_spacing_small"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
