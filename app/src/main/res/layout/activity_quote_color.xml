<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/screenHeader"
        layout="@layout/view_screen_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ui_screen_padding_horizontal"
            android:paddingTop="@dimen/ui_content_spacing"
            android:paddingEnd="@dimen/ui_screen_padding_horizontal"
            android:paddingBottom="@dimen/ui_content_spacing_large">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="2dp"
                android:paddingTop="@dimen/ui_content_spacing_large"
                android:paddingBottom="7dp"
                android:text="Fragmento"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/selectedText"
                style="@style/Widget.MichisReader.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="2dp"
                android:paddingTop="@dimen/ui_content_spacing_large"
                android:paddingBottom="7dp"
                android:text="Apariencia y nota"
                android:textSize="17sp" />

            <LinearLayout
                style="@style/Widget.MichisReader.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/colorPreview"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="Color del resaltado" />

                <EditText
                    android:id="@+id/noteInput"
                    style="@style/Widget.MichisReader.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nota opcional"
                    android:inputType="textMultiLine"
                    android:minLines="2" />

                <Button
                    android:id="@+id/saveQuoteButton"
                    style="@style/Widget.MichisReader.Button"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Aplicar color y guardar cita" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
