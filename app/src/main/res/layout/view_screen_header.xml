<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/ui_screen_padding_horizontal"
    android:paddingTop="@dimen/ui_content_spacing_small"
    android:paddingEnd="@dimen/ui_screen_padding_horizontal"
    android:paddingBottom="@dimen/ui_content_spacing_small">

    <Button
        android:id="@+id/backButton"
        style="@style/Widget.MichisReader.Button"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ui_control_min_height"
        android:contentDescription="@string/action_back"
        android:minWidth="@dimen/ui_control_min_height"
        android:text="&#x2039;"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/titleText"
        android:layout_width="0dp"
        android:layout_height="@dimen/ui_header_height"
        android:layout_marginStart="@dimen/ui_content_spacing"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.MichisReader.ScreenTitle" />

    <LinearLayout
        android:id="@+id/actionContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal" />
</LinearLayout>
