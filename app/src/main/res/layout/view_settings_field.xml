<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/ui_content_spacing_small"
    android:paddingBottom="@dimen/ui_content_spacing_small">

    <TextView
        android:id="@+id/fieldLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/ui_content_spacing_small"
        android:paddingEnd="@dimen/ui_content_spacing_small"
        android:paddingBottom="@dimen/ui_content_spacing_small"
        android:textSize="15sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/controlContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/ui_content_spacing_small"
        android:paddingEnd="@dimen/ui_content_spacing_small" />
</LinearLayout>
