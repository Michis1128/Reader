<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="@dimen/ui_content_spacing"
    android:background="@drawable/background_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/ui_card_padding_horizontal"
    android:paddingTop="@dimen/ui_content_spacing"
    android:paddingEnd="@dimen/ui_card_padding_horizontal"
    android:paddingBottom="@dimen/ui_content_spacing">

    <TextView
        android:id="@+id/folderIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/folderName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_content_spacing"
        android:layout_weight="1"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/navigationArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="28sp" />
</LinearLayout>
