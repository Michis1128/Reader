<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/ui_screen_padding_horizontal"
    android:paddingTop="@dimen/ui_screen_padding_vertical"
    android:paddingEnd="@dimen/ui_screen_padding_horizontal"
    android:paddingBottom="@dimen/ui_screen_padding_vertical">

    <include
        android:id="@+id/screenHeader"
        layout="@layout/view_screen_header" />

    <TextView
        android:id="@+id/resetDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/ui_content_spacing_small"
        android:paddingEnd="@dimen/ui_content_spacing_small"
        android:paddingBottom="@dimen/ui_content_spacing" />

    <LinearLayout
        style="@style/Widget.MichisReader.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/queryInput"
            style="@style/Widget.MichisReader.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Buscar por título, autor o archivo EPUB"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/ui_content_spacing"
            android:paddingBottom="@dimen/ui_content_spacing_small"
            android:text="Ordenar por"
            android:textStyle="bold" />

        <com.michis.reader.ui.LimitedHeightSpinner
            android:id="@+id/sortSpinner"
            style="@style/Widget.MichisReader.Spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/selectionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/ui_content_spacing_small"
        android:paddingTop="@dimen/ui_content_spacing"
        android:paddingEnd="@dimen/ui_content_spacing_small"
        android:paddingBottom="@dimen/ui_content_spacing_small"
        android:textStyle="bold" />

    <Button
        android:id="@+id/selectAllButton"
        style="@style/Widget.MichisReader.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seleccionar todos los libros" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/selectVisibleButton"
            style="@style/Widget.MichisReader.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Seleccionar visibles" />

        <Button
            android:id="@+id/clearSelectionButton"
            style="@style/Widget.MichisReader.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Limpiar" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/listContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/resetSelectedButton"
        style="@style/Widget.MichisReader.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_content_spacing"
        android:text="Reiniciar seleccionados"
        android:textSize="16sp" />
</LinearLayout>
