<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/library_title"
            android:textAppearance="@style/TextAppearance.MichisReader.ScreenTitle"
            android:textSize="30sp" />

        <Button
            android:id="@+id/syncButton"
            style="@style/Widget.MichisReader.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Sincronizar ahora"
            android:text="↻"
            android:textSize="20sp" />

        <Button
            android:id="@+id/settingsButton"
            style="@style/Widget.MichisReader.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/settings_title"
            android:text="⚙"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="@dimen/ui_content_spacing_large"
        android:text="Tus lecturas, disponibles sin conexión"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/syncStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/ui_content_spacing_small"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/searchInput"
            style="@style/Widget.MichisReader.Input"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:hint="Buscar por título, autor o archivo EPUB"
            android:inputType="text"
            android:maxLines="1" />

        <Button
            android:id="@+id/importButton"
            style="@style/Widget.MichisReader.Button"
            android:layout_width="52dp"
            android:layout_height="54dp"
            android:layout_marginStart="@dimen/ui_content_spacing"
            android:contentDescription="Importar"
            android:text="+"
            android:textSize="22sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/ui_content_spacing"
            android:paddingBottom="@dimen/ui_content_spacing">

            <Button
                android:id="@+id/libraryTabButton"
                style="@style/Widget.MichisReader.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Biblioteca"
                android:textSize="12sp" />

            <Button
                android:id="@+id/quotesTabButton"
                style="@style/Widget.MichisReader.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quotes_title"
                android:textSize="12sp" />

            <Button
                android:id="@+id/bookmarksTabButton"
                style="@style/Widget.MichisReader.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bookmarks_title"
                android:textSize="12sp" />

            <Button
                android:id="@+id/dictionariesTabButton"
                style="@style/Widget.MichisReader.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dictionaries_title"
                android:textSize="12sp" />

            <Button
                android:id="@+id/libraryDisplayButton"
                style="@style/Widget.MichisReader.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp" />

            <Button
                android:id="@+id/libraryFilterButton"
                style="@style/Widget.MichisReader.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/libraryPathText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/ui_content_spacing_small"
        android:paddingTop="2dp"
        android:paddingEnd="@dimen/ui_content_spacing_small"
        android:paddingBottom="@dimen/ui_content_spacing"
        android:text="@string/library_title"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="@dimen/ui_content_spacing_small">

        <LinearLayout
            android:id="@+id/documentList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/emptyMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingTop="80dp"
                android:paddingEnd="20dp"
                android:paddingBottom="30dp"
                android:text="Aún no hay libros EPUB.\nImporta uno para comenzar."
                android:textSize="18sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
