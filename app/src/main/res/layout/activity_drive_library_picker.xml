<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/ui_screen_padding_horizontal"
    android:paddingTop="@dimen/ui_screen_padding_vertical"
    android:paddingEnd="@dimen/ui_screen_padding_horizontal"
    android:paddingBottom="@dimen/ui_screen_padding_vertical">

    <include
        android:id="@+id/screenHeader"
        layout="@layout/view_screen_header" />

    <TextView
        android:id="@+id/selectionDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/ui_content_spacing_small"
        android:paddingEnd="@dimen/ui_content_spacing_small"
        android:paddingBottom="@dimen/ui_content_spacing" />

    <TextView
        android:id="@+id/locationText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/ui_content_spacing_small"
        android:paddingEnd="@dimen/ui_content_spacing_small"
        android:paddingBottom="@dimen/ui_content_spacing"
        android:text="Mi unidad"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/searchInput"
        style="@style/Widget.MichisReader.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ui_content_spacing"
        android:hint="Buscar carpetas o libros EPUB"
        android:inputType="text"
        android:maxLines="1" />

    <TextView
        android:id="@+id/resultCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/ui_content_spacing_small"
        android:paddingBottom="@dimen/ui_content_spacing_small"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/listContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/applySelectionButton"
        style="@style/Widget.MichisReader.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_content_spacing"
        android:text="Aplicar selección"
        android:textSize="16sp" />
</LinearLayout>
