<?xml version="1.0" encoding="utf-8"?>
<remote-actions
    version="1.2"
    actionset_label="@string/spen_actions">

    <action
        id="button_click"
        label="@string/spen_next_page"
        priority="1"
        trigger_key="SPACE">
        <preference
            name="gesture"
            value="click" />
        <preference
            name="button_only"
            value="true" />
    </action>

    <action
        id="button_double_click"
        label="@string/spen_previous_page"
        priority="2"
        trigger_key="DEL">
        <preference
            name="gesture"
            value="double_click" />
        <preference
            name="button_only"
            value="true" />
    </action>

    <action
        id="swipe_up"
        label="@string/spen_increase_text"
        priority="3"
        trigger_key="DPAD_UP">
        <preference name="gesture" value="swipe_up" />
        <preference name="motion_only" value="true" />
    </action>

    <action
        id="swipe_down"
        label="@string/spen_decrease_text"
        priority="4"
        trigger_key="DPAD_DOWN">
        <preference name="gesture" value="swipe_down" />
        <preference name="motion_only" value="true" />
    </action>

    <action
        id="swipe_left"
        label="@string/spen_previous_page"
        priority="5"
        trigger_key="PAGE_UP">
        <preference name="gesture" value="swipe_left" />
        <preference name="motion_only" value="true" />
    </action>

    <action
        id="swipe_right"
        label="@string/spen_next_page"
        priority="6"
        trigger_key="PAGE_DOWN">
        <preference name="gesture" value="swipe_right" />
        <preference name="motion_only" value="true" />
    </action>

    <action
        id="circle_counterclockwise"
        label="@string/spen_change_theme"
        priority="7"
        trigger_key="MINUS">
        <preference name="gesture" value="circle_ccw" />
        <preference name="motion_only" value="true" />
    </action>

    <action
        id="circle_clockwise"
        label="@string/spen_toggle_bookmark"
        priority="8"
        trigger_key="PLUS">
        <preference name="gesture" value="circle_cw" />
        <preference name="motion_only" value="true" />
    </action>
</remote-actions>
