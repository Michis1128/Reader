<?xml version="1.0" encoding="utf-8"?>
<remote-actions
    version="1.2"
    actionset_label="@string/spen_actions">

    <action
        id="next_page"
        label="@string/spen_next_page"
        priority="1"
        trigger_key="PAGE_DOWN">
        <preference
            name="gesture"
            value="click|swipe_left" />
    </action>

    <action
        id="previous_page"
        label="@string/spen_previous_page"
        priority="2"
        trigger_key="PAGE_UP">
        <preference
            name="gesture"
            value="double_click|swipe_right" />
    </action>
</remote-actions>
